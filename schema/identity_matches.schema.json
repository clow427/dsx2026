{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsx2026.example.org/schema/identity_matches.schema.json",
  "title": "Alumni Network Graph - identity matches",
  "description": "Produced by the identity module. Maps source-level person IDs to canonical person IDs and records why. Consumed by the merge step. See .kiro/specs/identity-resolution/design.md.",
  "type": "object",
  "required": ["schema_version", "generated_at", "matches"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "matches": { "type": "array", "items": { "$ref": "#/definitions/match" } }
  },
  "definitions": {
    "personId": {
      "type": "string",
      "pattern": "^person:[a-z0-9_]+:[A-Za-z0-9._-]+$"
    },
    "match": {
      "type": "object",
      "required": ["canonical_id", "status", "confidence", "member_ids", "signals"],
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "type": "string",
          "pattern": "^person:canonical:[a-z0-9-]+$"
        },
        "status": {
          "description": "merged = member_ids collapse into canonical_id; candidate = shown as SAME_AS_CANDIDATE, not merged; rejected = explicitly different people.",
          "enum": ["merged", "candidate", "rejected"]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "member_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/personId" }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["signal", "detail"],
            "additionalProperties": false,
            "properties": {
              "signal": {
                "enum": [
                  "orcid",
                  "exact_name",
                  "name_variant",
                  "shared_affiliation",
                  "shared_coauthor",
                  "shared_topic",
                  "institutional_bio",
                  "user_submitted",
                  "manual_review"
                ]
              },
              "detail": { "type": "string" },
              "evidence_urls": {
                "type": "array",
                "items": { "type": "string", "format": "uri" }
              }
            }
          }
        },
        "reviewed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by": { "type": "string" },
            "at": { "type": "string", "format": "date" },
            "note": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "merged" } } },
          "then": { "properties": { "confidence": { "enum": ["high", "medium"] } } }
        }
      ]
    }
  }
}
