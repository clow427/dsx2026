# Copy to .env (gitignored) and fill in. All values are optional.

# OpenAlex API key (https://openalex.org/settings/api). Without it, requests
# share a small daily budget with everyone on your network's IP address.
OPENALEX_API_KEY=

# Contact email sent to OpenAlex as the `mailto` parameter so they can reach
# you if the client misbehaves. Optional when an API key is set.
OPENALEX_MAILTO=

# Semantic Scholar API key (https://www.semanticscholar.org/product/api).
# Optional: enrichment works without it but is more likely to be throttled.
S2_API_KEY=
